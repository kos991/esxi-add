# App
APP_PORT=8080
DB_PATH=/data/db/esxi-builder.db
CACHE_DIR=/data/builds
APP_IMAGE=ghcr.io/kos991/esxi-add:latest

# Build execution:
# - local: run PowerShell/PowerCLI inside the all-in-one container.
# - external: keep PowerShell/PowerCLI outside Docker; an external worker claims tasks through the API.
BUILD_MODE=local
WORKER_TOKEN=change-this-worker-token

# Redis runs inside the all-in-one container.
REDIS_URL=redis://127.0.0.1:6379

# Default storage bucket uses local disk under /data.
STORAGE_TYPE=local
STORAGE_PATH=/data/storage

# Encryption key for secret_key field (32 bytes hex).
ENCRYPTION_KEY=change-me-to-a-32-byte-secret-key
