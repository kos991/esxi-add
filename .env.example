# App
APP_PORT=8080
DB_PATH=/data/db/esxi-builder.db
CACHE_DIR=/data/builds

# Redis runs inside the all-in-one container.
REDIS_URL=redis://127.0.0.1:6379

# Default storage bucket uses local disk under /data.
STORAGE_TYPE=local
STORAGE_PATH=/data/storage

# MinIO also runs inside the all-in-one container.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Optional default S3 bucket values for MinIO-backed buckets.
DEFAULT_S3_ENDPOINT=127.0.0.1:9000
DEFAULT_S3_ACCESS_KEY=minioadmin
DEFAULT_S3_SECRET_KEY=minioadmin
DEFAULT_S3_BUCKET=esxi-builder
DEFAULT_S3_REGION=us-east-1
DEFAULT_S3_USE_SSL=false
DEFAULT_S3_PUBLIC_DOMAIN=http://localhost:9000

# Encryption key for secret_key field (32 bytes hex).
ENCRYPTION_KEY=change-me-to-a-32-byte-secret-key
